<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <Version>0.4.0-preview.3</Version>
    <Description>Platform-independent structured rich documents and RTF persistence.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TextEdit.Core/TextEdit.Core.csproj" />
    <InternalsVisibleTo Include="RichEdit.Core.Tests" />
    <InternalsVisibleTo Include="RichEdit.Maui" />
  </ItemGroup>
</Project>
