<maui:MauiWinUIApplication
    x:Class="RichEdit.Maui.TestApp.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui"
    xmlns:local="using:RichEdit.Maui.TestApp.WinUI">
    <maui:MauiWinUIApplication.Resources>
        <ResourceDictionary>
            <!-- This template belongs to the native WinUI Shell tab bar. -->
            <DataTemplate x:Key="TabBarNavigationViewMenuItem">
                <local:ShellTabItem x:Name="navViewItem" />
            </DataTemplate>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#176D65" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#86D9C6" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </maui:MauiWinUIApplication.Resources>
</maui:MauiWinUIApplication>
