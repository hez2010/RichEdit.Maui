<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RichEdit.Maui.TestApp"
             x:Class="RichEdit.Maui.TestApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/EditorTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="StudioTitleBar">
                <TitleBar Title="RichEdit Studio"
                          BackgroundColor="{AppThemeBinding Light={StaticResource LightCanvas}, Dark={StaticResource DarkCanvas}}"
                          ForegroundColor="{AppThemeBinding Light={StaticResource LightInk}, Dark={StaticResource DarkInk}}" />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
