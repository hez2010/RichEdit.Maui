{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "RichEdit.Maui/RichEdit.Maui.csproj",
            "CodeEdit.Maui/CodeEdit.Maui.csproj"
          ]
        }
      ],
      "dest": "api",
      "filter": "filter.yml",
      "properties": {
        "TargetFramework": "net10.0-windows10.0.19041.0",
        "TargetFrameworks": "net10.0-windows10.0.19041.0",
        "Configuration": "Release"
      },
      "namespaceLayout": "flattened",
      "memberLayout": "samePage"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "manual/**/*.md",
          "manual/**/toc.yml",
          "api/**/*.md",
          "api/**/*.yml"
        ]
      },
      {
        "src": "..",
        "files": ["RTF_SUPPORT.md"],
        "dest": "reference"
      }
    ],
    "resource": [
      {
        "src": "..",
        "files": ["Assets/rich-editor.png", "Assets/code-editor.png"]
      }
    ],
    "output": "_site",
    "template": ["default", "modern", "templates"],
    "globalMetadata": {
      "_appName": "RichEdit.Maui",
      "_appTitle": "RichEdit.Maui documentation",
      "_appFooter": "RichEdit.Maui · MIT licensed",
      "_enableSearch": true,
      "_lang": "en"
    }
  }
}
