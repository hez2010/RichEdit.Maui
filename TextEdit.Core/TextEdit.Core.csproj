<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <Version>0.4.0-preview.3</Version>
    <Description>Platform-independent document and selection primitives for native text editors.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TextEdit.Core.Tests" />
    <InternalsVisibleTo Include="RichEdit.Maui" />
    <InternalsVisibleTo Include="RichEdit.Core" />
  </ItemGroup>
</Project>
